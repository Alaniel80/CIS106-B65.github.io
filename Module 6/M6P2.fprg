<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M6P2"/>
        <attribute name="authors" value="alani"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-14 06:43:55 PM"/>
        <attribute name="created" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMTQ7MDY6MTc6MTUgUE07MjIzNw=="/>
        <attribute name="edited" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMTQ7MDY6NDM6NTUgUE07MjsyMzQ5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="PartNumber" type="Integer" array="False" size=""/>
            <declare name="Quantity" type="Integer" array="False" size=""/>
            <declare name="UnitCost" type="Integer" array="False" size=""/>
            <declare name="TotalCost" type="Integer" array="False" size=""/>
            <input variable="PartNumber"/>
            <input variable="Quantity"/>
            <if expression="PartNumber=10 or PartNumber=55">
                <then>
                    <assign variable="UnitCost" expression="1"/>
                </then>
                <else>
                    <if expression="PartNumber=99">
                        <then>
                            <assign variable="UnitCost" expression="2"/>
                        </then>
                        <else>
                            <if expression="PartNumber=80 or PartNumber=70">
                                <then>
                                    <assign variable="UnitCost" expression="3"/>
                                </then>
                                <else>
                                    <assign variable="UnitCost" expression="5"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="TotalCost" expression="Quantity*UnitCost"/>
            <output expression="&quot;PartNumber: &quot;&amp;PartNumber &amp;&quot; Cost per Unit: $&quot; &amp;UnitCost &amp;&quot; Total cost: $&quot; &amp;TotalCost" newline="True"/>
        </body>
    </function>
</flowgorithm>
