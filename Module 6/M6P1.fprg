<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M6P1"/>
        <attribute name="authors" value="alani"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-14 05:52:10 PM"/>
        <attribute name="created" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMTQ7MDU6Mjg6MTcgUE07MjI0MA=="/>
        <attribute name="edited" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMTQ7MDU6NTI6MTAgUE07MTsyMzM4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Quantity" type="Real" array="False" size=""/>
            <input variable="Quantity"/>
            <declare name="ExtendedPrice" type="Real" array="False" size=""/>
            <declare name="Price" type="Real" array="False" size=""/>
            <if expression="Quantity&gt;10000">
                <then>
                    <assign variable="Price" expression="10"/>
                </then>
                <else>
                    <if expression="Quantity&gt;=5000">
                        <then>
                            <assign variable="Price" expression="20"/>
                        </then>
                        <else>
                            <assign variable="Price" expression="30"/>
                        </else>
                    </if>
                </else>
            </if>
            <declare name="TaxAmount" type="Real" array="False" size=""/>
            <assign variable="ExtendedPrice" expression="Quantity*Price"/>
            <assign variable="TaxAmount" expression="ExtendedPrice*.07"/>
            <declare name="Total" type="Real" array="False" size=""/>
            <assign variable="Total" expression="ExtendedPrice+TaxAmount"/>
            <output expression="&quot;Extended price: $&quot; &amp;ExtendedPrice &amp; &quot; Tax anount: $&quot; &amp;TaxAmount &amp; &quot; Total: $&quot; &amp;Total" newline="True"/>
        </body>
    </function>
</flowgorithm>
