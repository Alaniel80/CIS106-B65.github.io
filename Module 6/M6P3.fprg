<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M6P3"/>
        <attribute name="authors" value="alani"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-14 07:40:31 PM"/>
        <attribute name="created" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMTQ7MDY6NDY6NTggUE07MjI0Ng=="/>
        <attribute name="edited" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMTQ7MDc6NDA6MzEgUE07MTsyMzQw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="PrincipleAmount" type="Integer" array="False" size=""/>
            <input variable="PrincipleAmount"/>
            <declare name="Year" type="Integer" array="False" size=""/>
            <input variable="Year"/>
            <declare name="FirstYearInt" type="Real" array="False" size=""/>
            <declare name="InterestRate" type="Real" array="False" size=""/>
            <declare name="InterestAmount" type="Real" array="False" size=""/>
            <if expression="PrincipleAmount&gt;100000 AND Year=5">
                <then>
                    <assign variable="InterestRate" expression="0.06"/>
                </then>
                <else>
                    <if expression="PrincipleAmount &gt;= 50000 AND PrincipleAmount &lt;= 100000 AND Year=10">
                        <then>
                            <assign variable="InterestRate" expression="0.05"/>
                        </then>
                        <else>
                            <if expression="PrincipleAmount &gt;= 50000 AND PrincipleAmount &lt;= 100000 AND Year=5">
                                <then>
                                    <assign variable="InterestRate" expression="0.04"/>
                                </then>
                                <else>
                                    <assign variable="InterestRate" expression="0.02"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="FirstYearInt" expression="PrincipleAmount*InterestRate"/>
            <output expression="&quot;Principle Amount:&quot; &amp;PrincipleAmount &amp; &quot; Interest rate:&quot; &amp;InterestRate &amp; &quot; First year Interest:&quot; &amp;FirstYearInt" newline="True"/>
        </body>
    </function>
</flowgorithm>
