<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M6P5"/>
        <attribute name="authors" value="alani"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-14 08:23:07 PM"/>
        <attribute name="created" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMTQ7MDg6MTQ6MzUgUE07MjIzOA=="/>
        <attribute name="edited" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMTQ7MDg6MjM6MDcgUE07MTsyMzQ1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="LastName" type="String" array="False" size=""/>
            <declare name="Salary" type="Real" array="False" size=""/>
            <declare name="JobLvl" type="Integer" array="False" size=""/>
            <input variable="LastName"/>
            <input variable="Salary"/>
            <input variable="JobLvl"/>
            <declare name="BonusRate" type="Real" array="False" size=""/>
            <declare name="BonusAmount" type="Real" array="False" size=""/>
            <if expression="JobLvl&gt;=10">
                <then>
                    <assign variable="BonusRate" expression="25"/>
                </then>
                <else>
                    <if expression="JobLvl&lt;=9 AND JobLvl&gt;=5">
                        <then>
                            <assign variable="BonusRate" expression="20"/>
                        </then>
                        <else>
                            <assign variable="BonusRate" expression="10"/>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="BonusAmount" expression="Salary*BonusRate/100"/>
            <output expression="&quot;Last Name:&quot; &amp;LastName &amp;&quot; Bonus: $&quot; &amp;BonusAmount" newline="True"/>
        </body>
    </function>
</flowgorithm>
