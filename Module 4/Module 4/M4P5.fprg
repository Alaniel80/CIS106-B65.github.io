<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M4P5"/>
        <attribute name="authors" value="alani"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-03 05:35:49 PM"/>
        <attribute name="created" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMDM7MDU6Mjc6NTYgUE07MjI0MA=="/>
        <attribute name="edited" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMDM7MDU6MzU6NDkgUE07MTsyMzQ5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="FixedCost" type="Real" array="False" size=""/>
            <input variable="FixedCost"/>
            <declare name="PricePerUnit" type="Real" array="False" size=""/>
            <input variable="PricePerUnit"/>
            <declare name="CostPerUnit" type="Real" array="False" size=""/>
            <input variable="CostPerUnit"/>
            <declare name="BreakEvenPoint" type="Real" array="False" size=""/>
            <assign variable="BreakEvenPoint" expression="FixedCost/(PricePerUnit-CostPerUnit)"/>
            <output expression="&quot;You need to sell &quot;&amp;BreakEvenPoint &amp;&quot; items&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
