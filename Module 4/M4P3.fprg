<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M4P3"/>
        <attribute name="authors" value="alani"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-03 05:08:13 PM"/>
        <attribute name="created" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMDM7MDQ6MTE6NDYgUE07MjIzMQ=="/>
        <attribute name="edited" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMDM7MDU6MDg6MTMgUE07MjsyMzQx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="TotalForAMeal" type="Real" array="False" size=""/>
            <input variable="TotalForAMeal"/>
            <declare name="Tip15Perc" type="Real" array="False" size=""/>
            <declare name="Tip18Perc" type="Real" array="False" size=""/>
            <declare name="Tip20Perc" type="Real" array="False" size=""/>
            <assign variable="Tip15Perc" expression="TotalForAMeal*.15"/>
            <assign variable="Tip18Perc" expression="TotalForAMeal*.18"/>
            <assign variable="Tip20Perc" expression="TotalForAMeal*.2"/>
            <declare name="TotalWithTip15Perc" type="Real" array="False" size=""/>
            <assign variable="TotalWithTip15Perc" expression="TotalForAMeal+Tip15Perc"/>
            <declare name="TotalWithTip18Perc" type="Real" array="False" size=""/>
            <assign variable="TotalWithTip18Perc" expression="TotalForAMeal+Tip18Perc"/>
            <declare name="TotalWithTip20Perc" type="Real" array="False" size=""/>
            <assign variable="TotalWithTip20Perc" expression="TotalForAMeal+Tip20Perc"/>
            <output expression="&quot;With 15% Tip:&quot; &amp;&#13;&#10;&quot;Total: &quot; &amp;TotalForAMeal &amp;&#13;&#10;&quot;Tip: &quot; &amp;Tip15Perc &amp;&#13;&#10;&quot;Total with Tip &quot; &amp;TotalWithTip15Perc &amp;&#13;&#10;&#13;&#10;&quot;With 18% Tip:&quot; &amp;&#13;&#10;&quot;Total: &quot; &amp;TotalForAMeal &amp;&#13;&#10;&quot;Tip: &quot; &amp;Tip18Perc &amp;&#13;&#10;&quot;Total with Tip &quot; &amp;TotalWithTip18Perc &amp;&#13;&#10;&#13;&#10;&quot;With 20% Tip:&quot; &amp;&#13;&#10;&quot;Total: &quot;&amp;TotalForAMeal &amp;&#13;&#10;&quot;Tip: &quot;&amp;Tip20Perc &amp;&#13;&#10;&quot;Total with Tip &quot; &amp;TotalWithTip20Perc" newline="True"/>
        </body>
    </function>
</flowgorithm>
