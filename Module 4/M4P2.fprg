<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M4P2"/>
        <attribute name="authors" value="alani"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-03 12:02:32 PM"/>
        <attribute name="created" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMDM7MTE6NDM6MDYgQU07MjIxNQ=="/>
        <attribute name="edited" value="YWxhbmk7QUxBTklTOzIwMjYtMTAtMDM7MTI6MDI6MzIgUE07MTsyMzMz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="PricePerShare" type="Real" array="False" size=""/>
            <declare name="CurrentStockPrice" type="Real" array="False" size=""/>
            <declare name="QuantityOfStock" type="Real" array="False" size=""/>
            <input variable="PricePerShare"/>
            <input variable="CurrentStockPrice"/>
            <input variable="QuantityOfStock"/>
            <declare name="ValueOfStock" type="Real" array="False" size=""/>
            <assign variable="ValueOfStock" expression="(CurrentStockPrice-PricePerShare)*QuantityOfStock"/>
            <output expression="&quot;Value of stock is: $&quot;&amp;ValueOfStock &amp;&#13;&#10;&quot; If number is positive value insreased&quot; &amp; &quot; If number is negative value decreased&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
