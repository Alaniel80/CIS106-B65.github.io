    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Firstname" type="String" array="False" size=""/>
            <declare name="NumberOfSteps" type="Integer" array="False" size=""/>
            <input variable="FirstName"/>
            <input variable="NumberOfSteps"/>
            <declare name="NumberofCalories" type="Real" array="False" size=""/>
            <assign variable="NumberOfCalories" expression="NumberOfSteps*.25"/>
            <output expression="&quot;First Name: &quot; &amp;FirstName &amp;&quot; calories burned: &quot;&amp;NumberOfCalories" newline="True"/>
        </body>
    </function>
</flowgorithm>
